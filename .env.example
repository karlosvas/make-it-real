# Copia este archivo como .env (en la raíz del repo) y rellena los valores.
# Crea la app en: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:               http://127.0.0.1:8787
#   Authorization callback URL: http://127.0.0.1:8787/auth/github/callback

MIR_GITHUB_CLIENT_ID=
MIR_GITHUB_CLIENT_SECRET=

# URL desde la que abres la web (tiene que coincidir con la callback de la OAuth App).
# Si usas ./scripts/dev.sh (Astro en :4321), crea otra OAuth App con callback
# http://localhost:4321/auth/github/callback y pon aquí http://localhost:4321
MIR_PUBLIC_URL=http://127.0.0.1:8787
