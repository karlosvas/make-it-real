---
import Base from '../layouts/Base.astro';
import { loadExercises } from '../lib/exercises';
import AccountButton from '../components/AccountButton.tsx';

const exercises = loadExercises();
const groups = ['Fácil', 'Media', 'Difícil'].map((d) => ({ name: d, items: exercises.filter((e) => e.difficulty === d) })).filter((g) => g.items.length);
const first = exercises[0];
const badge: Record<string, string> = {
  Fácil: 'text-emerald-300 bg-emerald-400/10 border-emerald-400/30',
  Media: 'text-orange-300 bg-orange-400/10 border-orange-400/30',
  Difícil: 'text-rose-300 bg-rose-400/10 border-rose-400/30',
};
---

<Base title="Make It Real · LeetCode de gameplay para Unreal">
  <div class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60rem_30rem_at_70%_-10%,rgba(255,107,26,0.14),transparent),radial-gradient(40rem_30rem_at_0%_10%,rgba(56,189,248,0.08),transparent)]"></div>
    <div class="pointer-events-none absolute inset-0 opacity-[0.07] [background-image:linear-gradient(#fff_1px,transparent_1px),linear-gradient(90deg,#fff_1px,transparent_1px)] [background-size:48px_48px] [mask-image:linear-gradient(to_bottom,black,transparent_70%)]"></div>

    <header class="relative mx-auto flex max-w-6xl items-center gap-3 px-6 py-5">
      <img src="/favicon.svg" alt="" class="size-8" />
      <span class="font-display text-lg font-bold tracking-tight">Make It Real <span class="text-ink-400 font-medium">· MIR</span></span>
      <span class="ml-auto hidden rounded-full border border-ink-700 px-2.5 py-1 font-mono text-[11px] text-ink-300 sm:block">beta · {exercises.length} ejercicios</span>
      <AccountButton client:load />
    </header>

    <section class="relative mx-auto grid max-w-6xl items-center gap-12 px-6 pt-10 pb-20 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <p class="mb-4 font-mono text-xs tracking-[0.2em] text-mir-400 uppercase">LeetCode de gameplay para Unreal Engine</p>
        <h1 class="font-display text-5xl leading-[1.05] font-bold tracking-tight text-balance text-ink-100 sm:text-6xl">
          Escribe C++ de Unreal.<br /><span class="text-mir-500">Míralo funcionar.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-300">
          Ejercicios cortos con la API de Unreal (<code class="font-mono text-[0.9em] text-sky-300">FVector</code>, <code class="font-mono text-[0.9em] text-sky-300">AActor</code>, <code class="font-mono text-[0.9em] text-sky-300">FMath</code>, timers…). Pulsa ejecutar y mira en 3D cómo el monigote prueba tu código en cada escenario.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          {first && (
            <a id="cta-main" href={`/ejercicios/${first.id}/`} class="rounded-xl bg-mir-500 px-5 py-3 font-semibold text-ink-950 shadow-[0_10px_30px_-10px_rgba(255,107,26,.7)] transition hover:bg-mir-400">
              Empezar por el ejercicio 1 →
            </a>
          )}
          <a href="#ejercicios" class="rounded-xl border border-ink-600 px-5 py-3 font-medium text-ink-200 transition hover:border-ink-400">Ver los ejercicios</a>
        </div>
        <p id="progress-summary" class="mt-6 font-mono text-xs text-ink-400"></p>
      </div>

      <div class="relative">
        <div class="absolute -inset-6 rounded-[2rem] bg-mir-500/10 blur-3xl"></div>
        <div class="relative overflow-hidden rounded-2xl border border-ink-700 bg-ink-950 shadow-2xl">
          <div class="flex items-center gap-1.5 border-b border-ink-800 bg-ink-900 px-4 py-2.5">
            <span class="size-2.5 rounded-full bg-ink-600"></span><span class="size-2.5 rounded-full bg-ink-600"></span><span class="size-2.5 rounded-full bg-ink-600"></span>
            <span class="ml-3 font-mono text-xs text-ink-300">Door.cpp</span>
          </div>
          <pre class="overflow-x-auto p-5 font-mono text-[13px] leading-6 text-ink-200"><span class="text-[#c792ea]">bool</span> <span class="text-[#82aaff]">ADoor</span>::<span class="text-[#82aaff]">CanOpen</span>(<span class="text-[#c792ea]">const</span> <span class="text-[#82aaff]">AActor</span>* Who) <span class="text-[#c792ea]">const</span>
{'{'}
    <span class="text-[#c792ea]">const</span> <span class="text-[#82aaff]">FVector</span> ToWho =
        (Who->GetActorLocation() - GetActorLocation())
        .GetSafeNormal();

    <span class="text-[#6b7a99] italic">// ¿Está en el lado hacia el que mira la puerta?</span>
    <span class="text-[#c792ea]">return</span> <span class="text-[#82aaff]">FVector</span>::DotProduct(
        GetActorForwardVector(), ToWho) &gt; <span class="text-[#f78c6c]">0.0</span>;
{'}'}</pre>
          <div class="grid grid-cols-2 gap-2 border-t border-ink-800 bg-ink-900 p-3 text-sm">
            <div class="flex items-center gap-2 rounded-lg bg-emerald-400/10 px-3 py-2 text-emerald-300"><b>✓</b> Desde delante</div>
            <div class="flex items-center gap-2 rounded-lg bg-emerald-400/10 px-3 py-2 text-emerald-300"><b>✓</b> Desde detrás</div>
            <div class="flex items-center gap-2 rounded-lg bg-emerald-400/10 px-3 py-2 text-emerald-300"><b>✓</b> Diagonal delante</div>
            <div class="flex items-center gap-2 rounded-lg bg-emerald-400/10 px-3 py-2 text-emerald-300"><b>✓</b> Diagonal detrás</div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <main id="ejercicios" class="mx-auto max-w-6xl px-6 pb-24">
    {groups.map((g) => (
      <section class="mt-10">
        <h2 class="mb-4 flex items-center gap-3 font-display text-xl font-semibold text-ink-100">
          {g.name}
          <span class="h-px flex-1 bg-ink-800"></span>
        </h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((e) => (
            <a
              href={`/ejercicios/${e.id}/`}
              data-exercise={e.id}
              data-number={e.number}
              data-title={e.title}
              class="group relative flex flex-col rounded-2xl border border-ink-700 bg-ink-850 p-5 transition hover:-translate-y-0.5 hover:border-ink-500 hover:bg-ink-800"
            >
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs text-ink-400">#{String(e.number).padStart(2, '0')}</span>
                <span class={`rounded-full border px-2 py-0.5 text-[11px] font-medium ${badge[e.difficulty] ?? ''}`}>{e.difficulty}</span>
                <span class="solved-badge ml-auto hidden rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2 py-0.5 text-[11px] font-medium text-emerald-300">✓ Resuelto</span>
                <span class="next-badge ml-auto hidden rounded-full border border-mir-500/40 bg-mir-500/10 px-2 py-0.5 text-[11px] font-medium text-mir-300">Siguiente</span>
              </div>
              <h3 class="mt-3 font-display text-lg font-semibold text-ink-100 group-hover:text-mir-400">{e.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-300">{e.summary}</p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {e.api.slice(0, 3).map((a) => (
                  <span class="rounded-md bg-ink-700/70 px-1.5 py-0.5 font-mono text-[11px] text-sky-300">{a.split('::').pop()}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
    <footer class="mt-20 border-t border-ink-800 pt-6 text-xs leading-relaxed text-ink-400">
      Make It Real simula una parte de la API de Unreal Engine 5 (mismos nombres y comportamiento): tu C++ se compila a WebAssembly con clang y se ejecuta en un mundo simulado por <span class="font-mono">mir-server</span> (Rust). No es Unreal Engine ni está afiliado a Epic Games.
    </footer>
  </main>

  <script>
    function refreshBadges() {
      const cards = [...document.querySelectorAll<HTMLAnchorElement>('[data-exercise]')].sort((a, b) => Number(a.dataset.number) - Number(b.dataset.number));
      const isSolved = (card: HTMLElement) => {
        try {
          return localStorage.getItem(`mir:solved:${card.dataset.exercise}`) === '1';
        } catch {
          return false;
        }
      };
      const solved = cards.filter(isSolved).length;
      // El siguiente: el primer ejercicio (por número) que aún no está resuelto.
      const next = solved > 0 ? cards.find((c) => !isSolved(c)) : undefined;
      cards.forEach((card) => {
        card.querySelector('.solved-badge')?.classList.toggle('hidden', !isSolved(card));
        card.querySelector('.next-badge')?.classList.toggle('hidden', card !== next);
        card.classList.toggle('ring-1', card === next);
        card.classList.toggle('ring-mir-500/50', card === next);
      });

      const summary = document.getElementById('progress-summary');
      if (summary) summary.textContent = solved > 0 ? `Llevas ${solved} de ${cards.length} ejercicios resueltos.` : '';

      const cta = document.getElementById('cta-main') as HTMLAnchorElement | null;
      if (cta && cards.length) {
        if (solved === 0) {
          cta.href = cards[0].href;
          cta.textContent = 'Empezar por el ejercicio 1 →';
        } else if (next) {
          cta.href = next.href;
          cta.textContent = `Continuar: ${next.dataset.number}. ${next.dataset.title} →`;
        } else {
          cta.href = cards[0].href;
          cta.textContent = '¡Los has resuelto todos! Repasar →';
        }
      }
    }
    refreshBadges();
    window.addEventListener('mir:progress', refreshBadges);
  </script>
</Base>
